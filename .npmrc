# 让 better-sqlite3 的 prebuild-install 从 npmmirror(国内镜像)下载预编译二进制,
# 而不是 GitHub Releases(国内网络常被墙),避免回退到需要 Visual Studio 的 node-gyp 源码编译。
# 镜像地址详见: https://npmmirror.com/mirrors/better-sqlite3/
better_sqlite3_binary_host=https://registry.npmmirror.com/-/binary/better-sqlite3

# 当 node_modules 与 lockfile 不一致时,pnpm 默认会交互式询问是否重建。
# 关闭该询问,让 pnpm install 自动重建而不打断(分发后无人值守更省心)。
confirm-modules-purge=false
